<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        .change{
            display: none;
        }
        .change.show{
            display: block;
        }
        #myButton{
            display: none;
        }
        #myButton.show{
            display: block;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        const id = window.location.pathname.split("/").pop();
        console.log(id);
        function goCommunicate(){
            window.location.href = '/api/community'
        }
        function goUpdateCommunity(){
            window.location.href = `/api/community/update/${id}`;
        }
        async function destroyCommunicate(){
            let url = '/api/community/posts/'+id;
            const response = await fetch(url,{
                method:'DELETE'
            })
            if (!response.ok) {
                const data = await response.json();
                alert(data.message);
            }
            window.location.href = "/api/community";
        }

        async function commentLike({post_id,comment_id}) {
            
            const url = '/api/community/commentLike/'+comment_id;
            console.log(url);
            await fetch(url,{
                method:'POST',
                headers:{
                    'Content-Type':'application/json'
                },
                body:JSON.stringify({
                    post_id
                })
            })
        }
        function toggle(button){
            const form = button.parentElement.querySelector(".change");
            form.classList.toggle('show');
        }
        async function getData(){
            const response = await axios(`/api/community/posts/${id}/data`)
            const data = response.data; 
            document.getElementById('post_id').value = data.data.post_id;
            document.getElementById('title').innerText = data.data.title
            document.getElementById('nickname').innerText = data.data.User.nickname
            document.getElementById('fishtype').innerText = data.data.fish_type
            document.getElementById('content').innerText = data.data.content;
            if(data.mine){
                const mybutton = document.getElementById('myButton')
                mybutton.classList.add('show')
            }
            const commentDatas = data.commentDatas
            const replyDatas = data.replyData
            const commentBox = document.getElementById('comment');
            commentBox.innerHTML = commentDatas.map(commentdata=>{
                const replies = data.replyData.filter(
                    reply => reply.parent_id === comment.comment_id
                );
                const ownerButton = commentdata.user_id === data.user_id ?
                `
                <div>
                    <button onclick="toggle(this)">변경하기</button>
                    <button onclick="">삭제하기</button>
                    <form action="/api/community/comment" method="POST" class="change">
                        <input type="hidden" name="post_id" value=${data.data.post_id}>
                        <input type="hidden" name="comment_id" value=${commentdata.commment_id}>
                        <textarea name="content"><textarea>
                        <button>변경하기</button>
                    </form>
                </div>` : '';
                const replyHtml = replies.map(reply=>{
                    let button = ''
                    if(reply.user_id == user_id){
                        button = `
                            <button onclick="toggle(this)">수정</button>
                            <button>삭제</button>
                            <form action="/api/community/comment" method="POST" class="change">
                                <input type="hidden" name="post_id" value=${data.data.post_id}>
                                <input type="hidden" name="comment_id" value=${commentdata.commment_id}>
                                <textarea name="content"></textarea>
                                <button>변경하기</button>
                            </form>
                        `
                    }
                    return `
                            <div class="replyData">
                                <p>${reply.User.nickname}</p>
                                <p>${reply.content}</p>
                                ${button}
                            </div>
                        `
                }).join("");
                return `
                    <div>
                        <p>${commentdata.User.nickname}</p>
                        <p>${commentdata.content}</p>
                        ${ownerButton}
                        <button>좋아요 ${commentdata.likeCount}</button>
                        <div>
                            <button onclick="toggle(this)">댓글달기</button>
                            <form class="change">
                                <fieldset></fieldset>
                                <button>답글</button>
                            </form>
                        </div>
                        <div class="replyData">
                            ${replyHtml}
                        </div>
                    </div>
                `
            }).join(''); 
        }
        getData()
    </script>
</head>
<body>
    <table>
        <tr>
            <th>제목</th>
            <td id="title"></td>
        </tr>
        <tr>
            <th>사용자</th>
            <td id="nickname"></td>
        </tr>
        <tr>
            <th>물고기 종류</th>
            <td id="fishtype"></td>
        </tr>
    </table>
    <div id="content">
       <!--여기는 내용--> 
    </div>
    <br>
    <div id="myButton">
     <button onclick="goUpdateCommunity()">수정하기</button>
     <button onclick="destroyCommunicate()">제거하기</button>
    </div>
    <button onclick="goCommunicate()">돌아가기</button>
    <form action="/api/community/comment" method="post">
        <input type="hidden" name="post_id" id="post_id">
        <textarea name="content" id="content" placeholder="답변을 작성해주세요"></textarea>
        <button>답변 제공</button>
    </form>
    <div id="comment"></div>
</body>
</html>